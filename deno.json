{
    "name": "@velotype/velodesign",
    "license": "MIT",
    "version": "0.1.0",
    "exports": {
        ".": "./src/index.ts"
    },
    "publish": {
        "exclude": [
            "docs/",
            "tests/",
            "showcase/"
        ]
    },
    "tasks": {
        "size": "deno run --allow-read --allow-write --allow-run --allow-env ./scripts/bundle-size.ts",
        "test": "cd ./tests/ && deno run 'bundle*' && cd .. && deno test --allow-read --allow-net --allow-sys --allow-env --allow-write --allow-run",
        "test-manual": "cd ./tests/ && deno run 'bundle*' && cd .. && deno run --allow-read --allow-net --allow-sys ./tests/manual_server.ts"
    },
    "lint": {
        "rules": {
            // velotype's JSX has no `key` prop at all, so every list render trips this React rule -
            // 72 findings, none of them real. Excluded so `deno lint` can be a CI gate.
            "exclude": [
                "jsx-key"
            ]
        }
    },
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "@velotype/velotype",
        "lib": ["dom", "deno.ns", "esnext"]
    },
    "imports": {
        "@astral/astral": "jsr:@astral/astral@^0.5.4",
        "@std/assert": "jsr:@std/assert@^1.0.16",
        "@std/testing": "jsr:@std/testing@^1.0.16",
        "@velotype/veloserver": "jsr:@velotype/veloserver@^0.1.5",
        "@velotype/velotype/jsx-runtime": "jsr:@velotype/velotype@^0.0.27",
        "@velotype/velotype": "jsr:@velotype/velotype@^0.0.27"
    }
  }